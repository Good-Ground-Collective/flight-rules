{
  "name": "@good-ground-collective/flight-rules",
  "version": "0.1.0",
  "description": "Claude Code Skills for the Good Ground Collective org",
  "license": "UNLICENSED",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\" --outfile=bin/flight-rules && chmod +x bin/flight-rules",
    "fmt": "sort-package-json && oxfmt",
    "fmt:check": "sort-package-json --check && oxfmt --check",
    "release": "semantic-release",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/github"
    ]
  },
  "dependencies": {
    "@octokit/graphql": "^9.0.3",
    "@octokit/rest": "^22.0.1",
    "commander": "^15.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.0",
    "oxfmt": "^0.52.0",
    "semantic-release": "^25.0.3",
    "sort-package-json": "^3.6.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.8"
  }
}
