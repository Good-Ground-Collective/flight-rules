{
  "name": "@good-ground-collective/flight-rules",
  "version": "0.1.0",
  "description": "Claude Code Skills for the Good Ground Collective org",
  "license": "UNLICENSED",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=bin/flight-rules && chmod +x bin/flight-rules",
    "fmt": "sort-package-json && oxfmt",
    "fmt:check": "sort-package-json --check && oxfmt --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.0",
    "oxfmt": "^0.52.0",
    "sort-package-json": "^3.6.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@octokit/graphql": "^9.0.3",
    "@octokit/rest": "^22.0.1",
    "commander": "^15.0.0",
    "zod": "^4.4.3"
  }
}
