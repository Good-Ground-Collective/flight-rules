{
  "description": "Route commits through the flight-rules CLI in repos that use flight-rules, strip Claude Code's attribution trailers from commits and PR bodies, and keep a status file per sub-agent under $XDG_STATE_HOME/flight-rules/agents so terminal multiplexers can show in-process sub-agents, and hand work to Codex over hc when the session or weekly usage limit is nearly used up",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/flight-rules.mjs", "hook", "pre-bash"],
            "timeout": 15
          },
          {
            "type": "command",
            "if": "Bash(gh pr *)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/flight-rules.mjs", "hook", "pre-bash"],
            "timeout": 15
          },
          {
            "type": "command",
            "if": "Bash(flight-rules *)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/flight-rules.mjs", "hook", "pre-bash"],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/flight-rules.mjs", "hook", "subagent-status", "--harness", "claude-code"],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/flight-rules.mjs", "hook", "usage-handoff", "--harness", "claude-code"],
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/flight-rules.mjs", "hook", "subagent-status", "--harness", "claude-code"],
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/flight-rules.mjs", "hook", "subagent-status", "--harness", "claude-code"],
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/flight-rules.mjs", "hook", "subagent-status", "--harness", "claude-code"],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/flight-rules.mjs", "hook", "subagent-status", "--harness", "claude-code"],
            "timeout": 2
          }
        ]
      }
    ]
  }
}
